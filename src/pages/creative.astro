---
import SaneLayout from "../layouts/SaneLayout.astro";
---

<SaneLayout title="David's Creative Portfolio">
  <section id="welcome" class="sane-stage" data-sane-stage>
    <div class="sane-stage-panel sane-welcome">
      <p class="sane-welcome-eyebrow">(⊙_⊙)</p>
      <h1 class="sane-welcome-title">Welcome to David's Creative Portfolio</h1>
    </div>
  </section>

  <section id="youtube" class="sane-stage" data-sane-stage>
    <div class="sane-stage-panel">
      <div class="sane-embed sane-embed--youtube">
        <iframe
          src="https://www.youtube.com/embed/rvEXl1QR1f0"
          title="YouTube video from Welcome Mooses"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
      <a
        href="https://www.youtube.com/@welcomemooses"
        class="sane-stage-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        David David David on YouTube
      </a>
    </div>
  </section>

  <section id="instagram" class="sane-stage" data-sane-stage>
    <div class="sane-stage-panel">
      <div class="sane-embed sane-embed--instagram">
        <iframe
          src="https://www.instagram.com/reel/CppCQ2UguRa/embed/"
          title="Instagram reel from Welcome Mooses"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
      <a
        href="https://www.instagram.com/welcomemooses"
        class="sane-stage-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        David David David on Instagram
      </a>
    </div>
  </section>

  <section id="spotify" class="sane-stage" data-sane-stage>
    <div class="sane-stage-panel">
      <iframe
        class="sane-embed-spotify"
        src="https://open.spotify.com/embed/playlist/5RccSrazKJYcpNCLK54qUH?utm_source=generator&si=31a086f51ed04701"
        title="Spotify playlist"
        width="100%"
        height="520"
        frameborder="0"
        allowfullscreen
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"></iframe>
      <a
        href="https://open.spotify.com/user/bilbaocow/"
        class="sane-stage-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        David David David on Spotify
      </a>
    </div>
  </section>
</SaneLayout>
